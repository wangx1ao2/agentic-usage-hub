# ──────────────────────────────────────────────────
# Agentic Usage Hub (多智能体统一监控看板配置)
# ──────────────────────────────────────────────────

# 看板 HTTP 服务监听端口（默认 4242）
PORT=4242

# 可选：自定义 Codex 生成图片扫描目录（多目录以系统路径分隔符隔开）
# CODEX_IMAGE_DIRS=

# 可选：自定义 OpenClaw 会话轨迹目录
# OPENCLAW_SESSIONS_DIR=

# 可选：自定义 Reasonix 计量日志文件路径
# REASONIX_USAGE_FILE=
