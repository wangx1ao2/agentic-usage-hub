# ──────────────────────────────────────────────────
# Agentic Usage Hub (多智能体统一监控看板配置)
# ──────────────────────────────────────────────────

# 看板 HTTP 服务监听端口（默认 4242）
PORT=4242

# 可选：派生索引与持久缓存目录（默认 ~/.cache/agentic-usage-hub，不修改原始 Agent 日志）
# AGENTIC_CACHE_DIR=

# 可选：Codex 日志与图片默认根目录（默认 ~/.codex）
# CODEX_HOME=

# 可选：业务 API 项目根目录，读取各项目 .local/、logs/ 中的 AiService 响应日志
# Windows 多项目以分号分隔；Linux/macOS 以冒号分隔。只读日志，不读取 API 密钥。
# BUSINESS_API_PROJECTS=E:\boss
# 可选：显式启用联网账号额度查询，每 30 秒及手动刷新读取一次（不调用模型）
# 默认关闭，与 BUSINESS_API_PROJECTS 独立；本地日志统计不依赖它。
# CODEX_ACCOUNT_QUOTA_ENABLED=1
# 可选：Codex 可执行文件；默认从 PATH 或业务项目运行时中寻找
# CODEX_QUOTA_BIN=
# CODEX_ACCOUNT_QUOTA_DISABLED=1
# 可选：自动审批路由的用户指定估算模型；默认未定价，不代表真实模型或扣费
# CODEX_AUTO_REVIEW_RATE_MODEL=gpt-6.1-sol

# 可选：原始会话/数据库位置；仅只读访问
# CLAUDE_SESSIONS_DIR=
# 默认 ~/.claude/projects
# ZCODE_DB_PATH=
# 默认 ~/.zcode/cli/db/db.sqlite
# ANTIGRAVITY_SESSIONS_DIR=
# 默认 ~/.gemini/antigravity/brain

# 可选：HTTP 服务监听地址（默认 127.0.0.1 仅本机访问；确需局域网共享设为 0.0.0.0）
# HOST=127.0.0.1

# 可选：自定义 Codex 生成图片扫描目录（多目录以系统路径分隔符隔开）
# 该白名单是 /api/codex-image 唯一允许的根目录来源；不在白名单内的路径一律 404。
# CODEX_IMAGE_DIRS=

# 可选：单目录便捷写法（等价于在 CODEX_IMAGE_DIRS 里追加一项）
# CODEX_IMAGE_DIR=

# 可选：ccusage CLI 子进程超时（毫秒，默认 90000）；网络受限环境可调小
# CCUSAGE_SPAWN_TIMEOUT=90000

# 可选：已安装在本机的 antigravity-usage 可执行文件路径；服务运行时不会通过 npx 下载
# ANTIGRAVITY_USAGE_BIN=

# 可选：自定义 OpenClaw 会话轨迹目录
# OPENCLAW_SESSIONS_DIR=

# 可选：自定义 Reasonix 计量日志文件路径
# REASONIX_USAGE_FILE=

# 可选：自定义 Qwen Code 会话目录（默认 ~/.qwen/projects，含 <工程>/chats/*.jsonl）
# QWEN_SESSIONS_DIR=

# 可选：自定义 Qwen / DashScope 扁平计量日志文件（默认 ~/.qwen/usage.jsonl）
# QWEN_USAGE_FILE=

# 可选：自定义 QoderWork CN (Qoder) 会话根目录（默认 ~/.qoderworkcn/projects，含 <工程>/<session>.jsonl）
# QODER_SESSIONS_DIR=

# 可选：QoderWork 正文估算系数（字符数 ÷ 1 token），默认 输入 2.8 / 输出 3.2
# QODER_EST_IN_CHARS_PER_TOKEN=2.8
# QODER_EST_OUT_CHARS_PER_TOKEN=3.2

# 可选：Qwen 百炼 CNY 定价折算美元所用汇率（默认 7.15 CNY/USD）
# QWEN_USD_CNY_RATE=7.15
# 可选：Qwen 费率参考地域。默认中国内地／北京；其他已核对选项为 global、intl-singapore。
# 地域/缓存模式未知时仅汇总已知金额，不把其他地域或控制台专属价当作当前费率。
# QWEN_PRICING_REGION=cn-beijing

# 可选：订阅费用与自定每周 API 等值预算 (默认: chatgpt_plus / $20 / $130)
# $130 是自定预算示例，不是官方周额度或五小时额度。
# DEFAULT_SUBSCRIPTION_PLAN=chatgpt_plus
# DEFAULT_SUBSCRIPTION_FEE=20
# DEFAULT_WEEKLY_ALLOWANCE=130
