{
  "name": "agentic-usage-hub",
  "version": "1.1.0-rc.2",
  "description": "Local-first token usage, cache-hit and USD cost analytics for coding agents. Offline log statistics, per-model pricing, live monitoring, project attribution and opt-in account quota reads.",
  "main": "unified-server.js",
  "bin": {
    "agentic-usage-hub": "bin/agentic-usage-hub.js"
  },
  "scripts": {
    "start": "node unified-server.js",
    "test": "node scripts/run-tests.cjs",
    "test:ui": "node tests/run-ui-check.cjs",
    "test:motion": "node tests/run-ui-check.cjs --motion",
    "test:upstream": "node scripts/check-ccusage.cjs",
    "test:package": "node scripts/check-package.cjs",
    "benchmark": "node tests/index-benchmark.cjs",
    "daily": "ccusage codex daily",
    "monthly": "ccusage codex monthly"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangx1ao2/agentic-usage-hub.git"
  },
  "keywords": [
    "token-usage",
    "cost-tracking",
    "usage-dashboard",
    "llm-analytics",
    "claude-code",
    "codex",
    "gemini-cli",
    "antigravity",
    "grok",
    "deepseek",
    "zcode",
    "zhipu",
    "qwen",
    "tongyi",
    "ai-agent",
    "developer-tools",
    "ccusage",
    "model-context-protocol",
    "mcp-server",
    "mcp"
  ],
  "author": "wangx1ao2",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wangx1ao2/agentic-usage-hub/issues"
  },
  "homepage": "https://github.com/wangx1ao2/agentic-usage-hub#readme",
  "files": [
    "bin",
    "lib",
    "mcp",
    "public",
    "*.js",
    ".env.example",
    "LICENSE",
    "README.md",
    "README_EN.md",
    "CHANGELOG.md",
    "docs/UPGRADING.md",
    "docs/SOURCE_SUPPORT.md",
    "llms.txt",
    "docs/images"
  ],
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "ccusage": "20.0.51",
    "chart.js": "4.6.1"
  }
}
