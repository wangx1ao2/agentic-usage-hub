{
  "name": "agentic-usage-hub",
  "version": "1.0.0",
  "description": "Local-first token usage, cache-hit and USD cost analytics dashboard for AI coding agents: OpenAI Codex CLI, Claude Code, Google Antigravity/Gemini, xAI Grok, DeepSeek OpenClaw/Reasonix and Zhipu ZCode. Runs fully offline via npx, with per-model pricing, live today view and per-project attribution.",
  "main": "unified-server.js",
  "bin": {
    "agentic-usage-hub": "./bin/agentic-usage-hub.js"
  },
  "scripts": {
    "start": "node unified-server.js",
    "test": "node --test tests/**/*.test.js",
    "daily": "ccusage codex daily",
    "monthly": "ccusage codex monthly"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangx1ao2/agentic-usage-hub.git"
  },
  "keywords": [
    "token-usage",
    "cost-tracking",
    "usage-dashboard",
    "llm-analytics",
    "claude-code",
    "codex",
    "gemini-cli",
    "antigravity",
    "grok",
    "deepseek",
    "zcode",
    "zhipu",
    "ai-agent",
    "developer-tools",
    "ccusage"
  ],
  "author": "wangx1ao2",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wangx1ao2/agentic-usage-hub/issues"
  },
  "homepage": "https://github.com/wangx1ao2/agentic-usage-hub#readme",
  "files": [
    "bin",
    "public",
    "*.js",
    ".env.example",
    "LICENSE",
    "README.md",
    "README_EN.md",
    "llms.txt",
    "docs/images"
  ],
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "ccusage": "^20.0.20",
    "chart.js": "^4.5.1"
  }
}
